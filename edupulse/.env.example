NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Used ONLY by scripts/seed-demo-users.mjs run on a developer machine.
